generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  password String

  @@map("user")
}

model Car {
  id               Int     @id @default(autoincrement())
  brand            String
  model            String
  year             Int
  version          String
  oil_quantity     Decimal
  coolant_quantity Decimal

  oil_engine_id        Int
  oil_transmission_id  Int
  oil_filter_id        Int
  fuel_filter_id       Int
  engine_air_filter_id Int
  cabin_filter_id      Int
  coolant_id           Int

  oil_engine        OilEngine       @relation(fields: [oil_engine_id], references: [id])
  oil_transmission  OilTransmission @relation(fields: [oil_transmission_id], references: [id])
  oil_filter        OilFilter       @relation(fields: [oil_filter_id], references: [id])
  fuel_filter       FuelFilter      @relation(fields: [fuel_filter_id], references: [id])
  engine_air_filter EngineAirFilter @relation(fields: [engine_air_filter_id], references: [id])
  cabin_filter      CabinFilter     @relation(fields: [cabin_filter_id], references: [id])
  coolant           Coolant         @relation(fields: [coolant_id], references: [id])

  @@map("car")
}

model OilEngine {
  id            Int    @id @default(autoincrement())
  name          String
  viscosity     String
  specification String

  car Car[]

  @@map("oil_engine")
}

model OilTransmission {
  id            Int    @id @default(autoincrement())
  name          String
  viscosity     String
  specification String

  car Car[]

  @@map("oil_transmission")
}

model OilFilter {
  id   Int    @id @default(autoincrement())
  name String

  car Car[]

  @@map("oil_filter")
}

model FuelFilter {
  id   Int    @id @default(autoincrement())
  name String

  car Car[]

  @@map("fuel_filter")
}

model EngineAirFilter {
  id   Int    @id @default(autoincrement())
  name String

  car Car[]

  @@map("engine_air_filter")
}

model CabinFilter {
  id   Int    @id @default(autoincrement())
  name String

  car Car[]

  @@map("cabin_filter")
}

model Coolant {
  id            Int    @id @default(autoincrement())
  name          String
  specification String

  car Car[]

  @@map("coolant")
}
