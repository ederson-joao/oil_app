generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  password String

  @@map("user")
}

model Car {
  id               String  @id
  brand            String
  model            String
  year             Int
  version          String
  oil_quantity     Decimal
  coolant_quantity Decimal

  oil_engine_id             String
  oil_transmission_id       String
  oil_filter_id             String
  fuel_filter_id            String
  engine_air_filter_id      String
  cabin_filter_id           String
  cabin_filter_with_coal_id String
  coolant_id                String

  oil_engine             OilEngine           @relation(fields: [oil_engine_id], references: [id])
  oil_transmission       OilTransmission     @relation(fields: [oil_transmission_id], references: [id])
  oil_filter             OilFilter           @relation(fields: [oil_filter_id], references: [id])
  fuel_filter            FuelFilter          @relation(fields: [fuel_filter_id], references: [id])
  engine_air_filter      EngineAirFilter     @relation(fields: [engine_air_filter_id], references: [id])
  cabin_filter           CabinFilter         @relation(fields: [cabin_filter_id], references: [id])
  cabin_filter_with_coal CabinFilterWithCoal @relation(fields: [cabin_filter_with_coal_id], references: [id])
  coolant                Coolant             @relation(fields: [coolant_id], references: [id])

  @@map("car")
}

model OilEngine {
  id            String @id
  name          String
  viscosity     String
  specification String

  car Car[]

  @@map("oil_engine")
}

model OilTransmission {
  id            String @id
  name          String
  viscosity     String
  specification String

  car Car[]

  @@map("oil_transmission")
}

model OilFilter {
  id   String @id
  name String

  car Car[]

  @@map("oil_filter")
}

model FuelFilter {
  id   String @id
  name String

  car Car[]

  @@map("fuel_filter")
}

model EngineAirFilter {
  id   String @id
  name String

  car Car[]

  @@map("engine_air_filter")
}

model CabinFilter {
  id   String @id
  name String

  car Car[]

  @@map("cabin_filter")
}

model CabinFilterWithCoal {
  id   String @id
  name String

  car Car[]

  @@map("cabin_filter_with_coal")
}

model Coolant {
  id            String @id
  name          String
  specification String

  car Car[]

  @@map("coolant")
}
